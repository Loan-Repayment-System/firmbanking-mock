# 이 파일을 .env로 복사해서 사용한다: cp .env.sample .env
# docker-compose.yml과 Spring(application.yml의 spring.config.import)이 같은 .env를 읽는다.
# 로컬 개발 전용 값이다. 운영 비밀값은 커밋되는 파일에 넣지 않는다.

MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=firmbanking
MYSQL_USER=firmbanking
MYSQL_PASSWORD=firmbanking1234
# repayment-backend의 MySQL(3306)과 함께 띄우므로 3307을 쓴다. 이미 쓰이고 있으면 이 값만 바꾼다.
MYSQL_PORT=3307

# repayment-backend(8080)와 함께 띄우므로 8081을 쓴다.
SERVER_PORT=8081
